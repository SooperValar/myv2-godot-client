;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Last Gate: Godot Tests"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[dotnet]

project/assembly_name="TheLastGate.GodotTests"
project/solution_directory="../../"
